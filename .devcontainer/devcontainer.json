{
  "name": "COLOR FUTURE AI — Phase 4 recovery",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "24" } },
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "COLOR FUTURE AI", "onAutoForward": "openBrowser" } },
  "postCreateCommand": "npm ci --no-audit --no-fund && npm run prepare:analysis",
  "postStartCommand": "node scripts/codespaces-start.mjs",
  "waitFor": "postCreateCommand"
}
